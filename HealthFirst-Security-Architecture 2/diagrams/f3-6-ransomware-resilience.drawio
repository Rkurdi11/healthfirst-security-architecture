;color:#4A5568;&quot;&gt;hardened Linux, object lock, no domain join&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#1A365D;strokeWidth=1.3;fontSize=11;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="c160"><mxGeometry x="12.0" y="210.0" width="376.0" height="72.0" as="geometry"/></mxCell><mxCell id="c164" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;EHR DR replication&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#4A5568;&quot;&gt;async to Central US · RPO ≤ 15 min&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#1A365D;strokeWidth=1.3;fontSize=11;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="c160"><mxGeometry x="12.0" y="298.0" width="376.0" height="72.0" as="geometry"/></mxCell><mxCell id="c166" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;EHR DR (warm standby)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#4A5568;&quot;&gt;fail over ≤ 4 h · annual full failover test&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B6CB0;strokeWidth=1.3;fontSize=11;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="c165"><mxGeometry x="12.0" y="34.0" width="200.0" height="110.0" as="geometry"/></mxCell><mxCell id="c167" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Restored workloads&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#4A5568;&quot;&gt;from cross-region backup copies&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B6CB0;strokeWidth=1.3;fontSize=11;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="c165"><mxGeometry x="218.0" y="34.0" width="200.0" height="110.0" as="geometry"/></mxCell><mxCell id="c169" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Recovery vault&lt;/span&gt;&lt;br&gt;&lt;span style=&quo