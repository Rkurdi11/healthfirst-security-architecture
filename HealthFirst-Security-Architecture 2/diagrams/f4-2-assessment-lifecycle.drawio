<mxfile host="drawio" agent="HealthFirst-architecture-toolkit" version="24.7.17"><diagram id="f4-2-assessment-lifecycle" name="f4-2-assessment-lifecycle"><mxGraphModel dx="1110" dy="528" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1110" pageHeight="528" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c22" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;1 · Plan&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#4A5568;&quot;&gt;architecture roadmap, standards, annual risk-appetite and SABSA attribute target review&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#4A5568;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="170.0" y="20.0" width="260.0" height="84.0" as="geometry"/></mxCell><mxCell id="c23" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;2 · Design review&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#4A5568;&quot;&gt;ARB gates: concept → design → pre-production; threat model and compliance mapping signed off&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF4FC;strokeColor=#2B6CB0;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="690.0" y="20.0" width="260.0" height="84.0" as="geometry"/></mxCell><mxCell id="c24" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;3 · Build &amp;amp; verify&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#4A5568;&quot;&gt;policy-as-code, IaC scanning, SAST / DAST / SCA, security acceptance tests before go-live&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF4FC;strokeColor=#2B6CB0;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="840.0" y="196.0" width="250.0" height="96.0" as="geometry"/></mxCell><mxCell id="c25" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;4 · Operate &amp;amp; monitor&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#4A5568;&quot;&gt;KPIs / KRIs, continuous compliance (Defender for Cloud, Azure Policy), SOC metrics&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F4FAF3;strokeColor=#3C7D3A;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="690.0" y="384.0" width="260.0" height="84.0" as="geometry"/></mxCell><mxCell id="c26" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;5 · Assess&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#4A5568;&quot;&gt;penetration tests, red / purple team, HIPAA &amp;amp; HITRUST audits, ZT maturity, DR and restore tests&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8EE;strokeColor=#D9822B;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="170.0" y="384.0" width="260.0" height="84.0" as="geometry"/></mxCell><mxCell id="c27" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;6 · Improve&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;color:#4A5568;&quot;&gt;findings → risk register → change requests, waivers with expiry, architecture updates (TOGAF Phase H)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBF9FF;strokeColor=#6B46C1;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="20.0" y="196.0" width="250.0" height="96.0" as="geometry"/></mxCell><mxCell id="c28" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Architecture governance core&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;SABSA Manage &amp;amp; Measure · TOGAF Phases G–H · architecture repository (single source of truth for designs, decisions, waivers and evidence)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF0FA;strokeColor=#1A365D;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="390.0" y="186.0" width="330.0" height="116.0" as="geometry"/></mxCell><mxCell id="c29" value="Cadence: design reviews per change · monthly KPI pack · quarterly ERC risk review · annual independent assessment and HIPAA risk analysis refresh." style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=10;fontColor=#4A5568;fontFamily=Helvetica;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="20.0" y="488.0" width="1070.0" height="20.0" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#1A365D;strokeWidth=1.4;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=10;fontColor=#2D3748;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e11" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#1A365D;strokeWidth=1.4;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=10;fontColor=#2D3748;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="965.0" y="62.0"/></Array></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#1A365D;strokeWidth=1.4;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=10;fontColor=