iteSpace=wrap;html=1;fillColor=#B7791F;strokeColor=#B7791F;strokeWidth=1.3;fontSize=11;fontColor=#FFFFFF;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="850.0" y="18.0" width="150.0" height="28.0" as="geometry"/></mxCell><mxCell id="c27" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Service management&lt;/span&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#6B46C1;strokeColor=#6B46C1;strokeWidth=1.3;fontSize=11;fontColor=#FFFFFF;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="1016.0" y="18.0" width="150.0" height="28.0" as="geometry"/></mxCell><mxCell id="c28" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Business drivers&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;Why does the business need this?&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#718096;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="20.0" y="56.0" width="150.0" height="54.0" as="geometry"/></mxCell><mxCell id="c29" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Business attributes&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;What qualities must the business have?&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#718096;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="186.0" y="56.0" width="150.0" height="54.0" as="geometry"/></mxCell><mxCell id="c30" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Control objectives&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;What must security achieve?&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#718096;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="352.0" y="56.0" width="150.0" height="54.0" as="geometry"/></mxCell><mxCell id="c31" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Security services&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;Which logical services deliver it?&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#718096;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="518.0" y="56.0" width="150.0" height="54.0" as="geometry"/></mxCell><mxCell id="c32" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Security mechanisms&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;How is it built?&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#718096;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="684.0" y="56.0" width="150.0" height="54.0" as="geometry"/></mxCell><mxCell id="c33" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Products &amp;amp; tools&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;With what exactly?&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#718096;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="850.0" y="56.0" width="150.0" height="54.0" as="geometry"/></mxCell><mxCell id="c34" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Metrics &amp;amp; operations&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;How do we know it works?&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#718096;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="1016.0" y="56.0" width="150.0" height="54.0" as="geometry"/></mxCell><mxCell id="c35" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;BD7 · Operational resilience&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;Keep clinical care running through ransomware and outages&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF4FC;strokeColor=#2B6CB0;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="20.0" y="140.0" width="150.0" height="96.0" as="geometry"/></mxCell><mxCell id="c36" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Recoverable · Available&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;Restore EHR within 4 h; EHR availability ≥ 99.95 %&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF4FC;strokeColor=#2B6CB0;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="186.0" y="140.0" width="150.0" height="96.0" as="geometry"/></mxCell><mxCell id="c37" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;CO-08 · Resilient recovery&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;Immutable, isolated backups; tested recovery within RTO/RPO&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF4FC;strokeColor=#2B6CB0;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="352.0" y="140.0" width="150.0" height="96.0" as="geometry"/></mxCell><mxCell id="c38" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Backup &amp;amp; recovery service&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;plus clinical-continuity (downtime) service&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF4FC;strokeColor=#2B6CB0;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="518.0" y="140.0" width="150.0" height="96.0" as="geometry"/></mxCell><mxCell id="c39" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Immutable vaults, MUA, IRE&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;isolated recovery tenant; read-only downtime (BCA) PCs&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF4FC;strokeColor=#2B6CB0;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="684.0" y="140.0" width="150.0" height="96.0" as="geometry"/></mxCell><mxCell id="c40" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Azure Backup (locked vault)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;Resource Guard, Veeam hardened repository, ASR&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF4FC;strokeColor=#2B6CB0;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="850.0" y="140.0" width="150.0" height="96.0" as="geometry"/></mxCell><mxCell id="c41" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;KPI-R1 / KPI-R2&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;100 % quarterly restore tests pass; measured RTO ≤ 4 h&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF4FC;strokeColor=#2B6CB0;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="1016.0" y="140.0" width="150.0" height="96.0" as="geometry"/></mxCell><mxCell id="c42" value="Example thread shown for business driver BD7. Every control in the architecture is traced the same way (see the full traceability matrix in Document 4)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10.5;fontColo