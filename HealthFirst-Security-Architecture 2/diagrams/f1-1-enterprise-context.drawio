<mxfile host="drawio" agent="HealthFirst-architecture-toolkit" version="24.7.17"><diagram id="f1-1-enterprise-context" name="f1-1-enterprise-context"><mxGraphModel dx="1160" dy="668" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1160" pageHeight="668" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="&lt;b&gt;HealthFirst Network — integrated delivery network&lt;/b&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#EFF6EE;strokeColor=#3C7D3A;strokeWidth=1.4;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12.5;fontColor=#2B5E2A;fontFamily=Helvetica;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="270.0" y="130.0" width="580.0" height="412.0" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Microsoft Azure (target)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EEF4FC;strokeColor=#2B6CB0;strokeWidth=1.4;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12.5;fontColor=#1E4E8C;fontFamily=Helvetica;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="910.0" y="130.0" width="230.0" height="300.0" as="geometry"/></mxCell><mxCell id="c1" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Regulators &amp;amp; oversight bodies&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;HHS OCR (HIPAA/HITECH) · EU supervisory authorities (GDPR) · FDA (medical devices) · CISA (incident reporting)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#4A5568;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="280.0" y="16.0" width="450.0" height="56.0" as="geometry"/></mxCell><mxCell id="c2" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Threat-intelligence community&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;Health-ISAC · HHS HC3 · CISA / FBI advisories&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#1A365D;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="750.0" y="16.0" width="390.0" height="56.0" as="geometry"/></mxCell><mxCell id="c4" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;15 hospitals&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;≈4,200 beds · ≈48,000 connected medical devices&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3C7D3A;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="c3"><mxGeometry x="18.0" y="38.0" width="172.0" height="72.0" as="geometry"/></mxCell><mxCell id="c5" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;60+ outpatient clinics&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;primary &amp;amp; specialty care, imaging, labs&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3C7D3A;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="c3"><mxGeometry x="203.0" y="38.0" width="172.0" height="72.0" as="geometry"/></mxCell><mxCell id="c6" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Research division&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;clinical trials, genomics, outcomes research&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E8C7E;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="c3"><mxGeometry x="388.0" y="38.0" width="174.0" height="72.0" as="geometry"/></mxCell><mxCell id="c7" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Workforce: ≈44,000 identities&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;physicians, nurses, allied health, admin, students, contractors&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B46C1;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="c3"><mxGeometry x="18.0" y="128.0" width="265.0" height="66.0" as="geometry"/></mxCell><mxCell id="c8" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Corporate &amp;amp; shared services&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;revenue cycle, HR, finance, supply chain, IT &amp;amp; SecOps&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#718096;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="c3"><mxGeometry x="296.0" y="128.0" width="266.0" height="66.0" as="geometry"/></mxCell><mxCell id="c9" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Current state: legacy estate (to be transformed)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;15 hospital data centers · disparate EHR systems · flat, interconnected networks with uneven controls · legacy medical devices with limited security&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7F7;strokeColor=#C53030;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;dashed=1;align=center;" vertex="1" parent="c3"><mxGeometry x="18.0" y="212.0" width="544.0" height="74.0" as="geometry"/></mxCell><mxCell id="c10" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Target: 2 consolidated data centers&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;retain sensitive and legacy workloads that stay on-premises · Azure Arc / Azure Local managed&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3C7D3A;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="c3"><mxGeometry x="18.0" y="304.0" width="265.0" height="90.0" as="geometry"/></mxCell><mxCell id="c11" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Security, privacy &amp;amp; compliance office&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;CISO (HIPAA Security Official) · Privacy Official · EU DPO · Clinical Engineering&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5568;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="c3"><mxGeometry x="296.0" y="304.0" width="266.0" height="90.0" as="geometry"/></mxCell><mxCell id="c13" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Telemedicine platform&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;virtual visits · secure messaging · remote patient monitoring&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B6CB0;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="c12"><mxGeometry x="15.0" y="36.0" width="200.0" height="70.0" as="geometry"/></mxCell><mxCell id="c14" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Centralized EHR platform&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;one patient record across all facilities&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B6CB0;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="c12"><mxGeometry x="15.0" y="118.0" width="200.0" height="70.0" as="geometry"/></mxCell><mxCell id="c15" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Research data-sharing platform&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;trusted research environment for de-identified data&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B6CB0;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="c12"><mxGeometry x="15.0" y="200.0" width="200.0" height="84.0" as="geometry"/></mxCell><mxCell id="c16" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Patients &amp;amp; caregivers&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;≈1.2M portal users · in-person, virtual and home monitoring&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8F98;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="20.0" y="168.0" width="190.0" height="80.0" as="geometry"/></mxCell><mxCell id="c17" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Referring &amp;amp; affiliated providers&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;record exchange via HIE / FHIR APIs&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8F98;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="20.0" y="280.0" width="190.0" height="72.0" as="geometry"/></mxCell><mxCell id="c18" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Remote &amp;amp; on-call clinicians&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;home, travel and partner sites&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B46C1;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="20.0" y="384.0" width="190.0" height="66.0" as="geometry"/></mxCell><mxCell id="c19" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;External research partners&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;≈25 universities, pharma sponsors and CROs (some EU-based)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8D6E4F;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="910.0" y="458.0" width="230.0" height="84.0" as="geometry"/></mxCell><mxCell id="c20" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Business associates &amp;amp; payers&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;clearinghouses, billing, cloud and IT service providers&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8D6E4F;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="270.0" y="584.0" width="280.0" height="64.0" as="geometry"/></mxCell><mxCell id="c21" value="&lt;span style=&quot;font-weight:bold;&quot;&gt;Medical device manufacturers&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px;color:#4A5568;&quot;&gt;remote support, patches, SBOM / MDS2 disclosures&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8D6E4F;strokeWidth=1.3;fontSize=12;fontColor=#1A202C;fontFamily=Helvetica;align=center;" vertex="1" parent="1"><mxGeometry x="570.0" y="584.0" width="280.0" height="64.0" as="geometry"/></mxCell><mxCell id="e1" value="in-person&lt;br&gt;care" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;startArrow=none;strokeColor=#4A5568;strokeWidth=1.4;exitX=1.0000;exitY=0.4500;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.0000;entryY=0.5000;entryDx=0;entryDy=0;entryPerimeter=0;fontSize=10;fontColor=#2D3748;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;" edge="1" parent="1" source="c16" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2